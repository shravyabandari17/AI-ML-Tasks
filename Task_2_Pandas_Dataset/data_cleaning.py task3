import pandas as pd

# --------------------------------------------------
# 1. Load the Dataset
# --------------------------------------------------

df = pd.read_csv("messy_students.csv")

print("========== BEFORE CLEANING ==========\n")

print("Original Dataset:")
print(df)


# --------------------------------------------------
# 2. Before Cleaning Analysis
# --------------------------------------------------

print("\nShape of Dataset:")
print(df.shape)

print("\nData Types:")
print(df.dtypes)

print("\nMissing Values:")
print(df.isnull().sum())

print("\nTotal Missing Values:")
print(df.isnull().sum().sum())

print("\nDuplicate Records:")
print(df.duplicated().sum())


# --------------------------------------------------
# 3. Correct Inappropriate Data Types
# --------------------------------------------------

print("\n========== CORRECTING DATA TYPES ==========\n")

# Convert Age to numeric
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")

# Convert Marks to numeric
df["Marks"] = pd.to_numeric(df["Marks"], errors="coerce")

# Convert Attendance to numeric
df["Attendance"] = pd.to_numeric(df["Attendance"], errors="coerce")

print("Data Types After Conversion:")
print(df.dtypes)


# --------------------------------------------------
# 4. Fill Missing Values
# --------------------------------------------------

print("\n========== HANDLING MISSING VALUES ==========\n")

# Fill missing Age with mean age
df["Age"] = df["Age"].fillna(df["Age"].mean())

# Fill missing Marks with mean marks
df["Marks"] = df["Marks"].fillna(df["Marks"].mean())

# Fill missing Attendance with mean attendance
df["Attendance"] = df["Attendance"].fillna(df["Attendance"].mean())

print("Missing Values After Filling:")
print(df.isnull().sum())


# --------------------------------------------------
# 5. Identify Duplicate Records
# --------------------------------------------------

print("\n========== REMOVING DUPLICATES ==========\n")

print("Number of duplicate records before removal:")
print(df.duplicated().sum())

# Remove duplicate records
df = df.drop_duplicates()

print("Number of duplicate records after removal:")
print(df.duplicated().sum())


# --------------------------------------------------
# 6. After Cleaning Analysis
# --------------------------------------------------

print("\n========== AFTER CLEANING ==========\n")

print("Cleaned Dataset:")
print(df)

print("\nShape of Cleaned Dataset:")
print(df.shape)

print("\nData Types:")
print(df.dtypes)

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Records:")
print(df.duplicated().sum())


# --------------------------------------------------
# 7. Save Cleaned Dataset
# --------------------------------------------------

df.to_csv("cleaned_students.csv", index=False)

print("\nCleaned dataset saved as 'cleaned_students.csv'")